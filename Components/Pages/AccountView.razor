@page "/accounts/{AccountId:guid}"
@using System.Linq
@using MDTadusMod.Data
@inject MDTadusMod.Services.AccountService AccountSvc
@inject MDTadusMod.Services.AssetService AssetService
@inject MDTadusMod.Services.SettingsService SettingsManager
@inject NavigationManager NavManager

@if (loading)
{
    <p><em>Loading...</em></p>
}
else if (notFound)
{
    <p><strong>Account not found.</strong></p>
}
else
{
    var VO = SettingsManager.GlobalOptions;

    <div class="mule">
        @if (!string.IsNullOrEmpty(accountData?.LastErrorMessage))
        {
            <div class="warning">
                <p>@accountData.LastErrorMessage</p>
                <button @onclick="DismissWarning">X</button>
            </div>
        }

        @if (VO.Email)
        {
            <input type="text" readonly class="guid" value="@account.Email" />
        }

        <header>
            @if (accountData?.Star > 0)
            {
                <span class="scont">
                    <span>@accountData.Star</span>
                    <span class="star" style="color:@GetStarColor(accountData.Star)">★</span>
                </span>
            }

            @if (VO.IGN)
            {
                <p class="mule-name" style="grid-column:2">
                    @(accountData?.Name ?? account.Email)
                </p>
            }

            <div class="header-actions" style="grid-column:3;">
                <button class="header-back-btn" @onclick="Back" title="Back">Back</button>
            </div>
        </header>

        <details open>
            <summary style="cursor:pointer;font-weight:bold;">
                Shiny Items Progress (@ownedShinyCount / @totalShinyCount)
            </summary>
            @if (shinyLoading)
            {
                <p><em>Scanning shiny items...</em></p>
            }
            else if (totalShinyCount == 0)
            {
                <p>No shiny item definitions found.</p>
            }
            else
            {
                <p>
                    Owned: @ownedShinyCount |
                    Missing: @missingShinyCount
                    (@(ownedShinyCount * 100 / (totalShinyCount == 0 ? 1 : totalShinyCount))% complete)
                </p>

                <div class="shiny-grid">
                    @foreach (var entry in combinedShinyEntries)
                    {
                        <SpriteCard Type="@entry.Id"
                                    BackgroundOff="true"
                                    Transparency="@(entry.Owned ? 1.0 : 0.25)" />
                    }
                </div>
            }
        </details>
    </div>
}

@code {
    [Parameter] public Guid AccountId { get; set; }

    private Account account;
    private AccountData accountData;
    private bool loading = true;
    private bool notFound;
    private bool shinyLoading = true;

    private HashSet<int> allShinyIds = new();
    private HashSet<int> ownedShinyIds = new();
    private int ownedShinyCount;
    private int missingShinyCount;
    private int totalShinyCount;
    private List<(int Id, bool Owned)> combinedShinyEntries = new();

    protected override async Task OnInitializedAsync()
    {
        account = (await AccountSvc.GetAccountsAsync()).FirstOrDefault(a => a.Id == AccountId);
        if (account == null)
        {
            notFound = true;
            loading = false;
            return;
        }

        accountData = await AccountSvc.GetAccountDataAsync(AccountId);
        loading = false;

        if (accountData != null)
            _ = LoadShinyAsync();
    }

    private async Task LoadShinyAsync()
    {
        try
        {
            shinyLoading = true;
            allShinyIds = await AssetService.GetAllShinyItemIdsAsync();
            var ownedItemIds = new HashSet<int>();

            void Add(IEnumerable<Item> items)
            {
                if (items == null) return;
                foreach (var it in items) if (it != null) ownedItemIds.Add(it.Id);
            }

            if (accountData.Characters != null)
            {
                foreach (var ch in accountData.Characters)
                    if (ch?.EquipmentList != null)
                        foreach (var it in ch.EquipmentList)
                            if (it != null) ownedItemIds.Add(it.Id);
            }

            Add(accountData.Vault?.Items);
            Add(accountData.MaterialStorage?.Items);
            Add(accountData.Gifts);
            Add(accountData.TemporaryGifts);
            Add(accountData.Potions);
            Add(accountData.SeasonalPetInventory?.Items);
            Add(accountData.NonSeasonalPetInventory?.Items);

            ownedShinyIds = new HashSet<int>(ownedItemIds.Where(id => allShinyIds.Contains(id)));
            ownedShinyCount = ownedShinyIds.Count;
            totalShinyCount = allShinyIds.Count;
            missingShinyCount = totalShinyCount - ownedShinyCount;

            var collInfo = await AssetService.GetEquipmentCollectionInfoAsync(allShinyIds);
            var iconMap = collInfo.ToDictionary(i => i.TypeId, i => i.CollectionIcon);

            combinedShinyEntries = allShinyIds
                .OrderBy(id => iconMap.GetValueOrDefault(id, int.MaxValue))
                .ThenBy(id => id)
                .Select(id => (id, ownedShinyIds.Contains(id)))
                .ToList();
        }
        finally
        {
            shinyLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void DismissWarning()
    {
        if (accountData != null)
            accountData.LastErrorMessage = null;
    }

    private void Back() => NavManager.NavigateTo("/");

    private string GetStarColor(int stars) => stars switch
    {
        >= 90 => "#fff",
        >= 72 => "#ff0",
        >= 54 => "#f6921d",
        >= 36 => "#c0262c",
        >= 18 => "#304cda",
        _ => "#8997dd"
    };
}